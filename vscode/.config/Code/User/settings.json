{
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 4,
  "editor.cursorSurroundingLinesStyle": "all",
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.highlightedyank.enable": true,
  "vim.sneak": true,
  "vim.surround": true,
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-h>": true,
    "<C-j>": true,
    "<C-k>": true,
    "<C-l>": true,
    "<C-d>": true,
    "<C-u>": true,
    "<C-o>": true,
    "<C-i>": true,
    "<C-/>": true,
    "<C-f>": false
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["Q"], "after": ["g", "q"] },
    { "before": ["<Esc>"], "commands": [":nohlsearch"] },
    { "before": ["<C-d>"], "after": ["<C-d>", "z", "z"] },
    { "before": ["<C-u>"], "after": ["<C-u>", "z", "z"] },
    { "before": ["n"], "after": ["n", "z", "z", "z", "v"] },
    { "before": ["N"], "after": ["N", "z", "z", "z", "v"] },
    { "before": ["v", "a", "g"], "after": ["g", "g", "v", "G", "$"] },
    { "before": ["v", "v"], "after": ["V"] },
    { "before": ["]", "<space>"], "after": ["o", "<Esc>", "k"] },
    { "before": ["[", "<space>"], "after": ["O", "<Esc>", "j"] },
    { "before": ["<C-h>"], "commands": ["workbench.action.focusLeftGroup"] },
    { "before": ["<C-j>"], "commands": ["workbench.action.focusBelowGroup"] },
    { "before": ["<C-k>"], "commands": ["workbench.action.focusAboveGroup"] },
    { "before": ["<C-l>"], "commands": ["workbench.action.focusRightGroup"] },
    { "before": ["<leader>", "w", "w"], "commands": ["workbench.action.focusNextGroup"] },
    { "before": ["<leader>", "w", "v"], "commands": ["workbench.action.splitEditorRight"] },
    { "before": ["<leader>", "w", "s"], "commands": ["workbench.action.splitEditorRight"] },
    { "before": ["<leader>", "w", "h"], "commands": ["workbench.action.splitEditorDown"] },
    { "before": ["<leader>", "w", "o"], "commands": ["workbench.action.joinAllGroups", "workbench.action.closeSidebar", "workbench.action.closePanel"] },
    { "before": ["<leader>", "w", "q"], "commands": ["workbench.action.closeActiveEditor"] },
    { "before": ["<leader>", "."], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "<space>"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "/"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "f", "r"], "commands": ["workbench.action.openRecent"] },
    { "before": ["<leader>", "f", "b"], "commands": ["workbench.action.showAllEditors"] },
    { "before": ["<leader>", "f", "F"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "E"], "commands": ["workbench.view.explorer"] },
    { "before": ["H"], "commands": ["workbench.action.previousEditorInGroup"] },
    { "before": ["L"], "commands": ["workbench.action.nextEditorInGroup"] },
    { "before": ["<leader>", ","], "commands": ["workbench.action.showAllEditors"] },
    { "before": ["<leader>", "b", "b"], "commands": ["workbench.action.showAllEditors"] },
    { "before": ["<leader>", "b", "d"], "commands": ["workbench.action.closeActiveEditor"] },
    { "before": ["<leader>", "b", "o"], "commands": ["workbench.action.closeOtherEditors"] },
    { "before": ["<leader>", "b", "r"], "commands": ["workbench.action.reopenClosedEditor"] },
    { "before": ["<leader>", "s", "g"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "s", "S"], "commands": ["workbench.action.showAllSymbols"] },
    { "before": ["<leader>", "s", "a"], "commands": ["workbench.action.showCommands"] },
    { "before": ["<leader>", "s", "d"], "commands": ["workbench.actions.view.problems"] },
    { "before": ["<leader>", "s", "r"], "commands": ["workbench.action.replaceInFiles"] },
    { "before": ["<leader>", "s", "s"], "commands": ["workbench.action.gotoSymbol"] },
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "D"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "t"], "commands": ["testing.goToRelatedTest"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    { "before": ["<leader>", "t", "t"], "commands": ["testing.runCurrentFile"] },
    { "before": ["<leader>", "t", "r"], "commands": ["testing.reRunLastRun"] },
    { "before": ["<leader>", "t", "d"], "commands": ["testing.debugCurrentFile"] },
    { "before": ["<leader>", "t", "m"], "commands": ["testing.runAtCursor"] },
    { "before": ["<leader>", "t", "M"], "commands": ["testing.debugAtCursor"] },
    { "before": ["<leader>", "t", "s"], "commands": ["testing.cancelRun"] },
    { "before": ["<leader>", "d", "b"], "commands": ["editor.debug.action.toggleBreakpoint"] },
    { "before": ["<leader>", "d", "d"], "commands": ["workbench.action.debug.start"] },
    { "before": ["<leader>", "d", "o"], "commands": ["workbench.action.debug.stepOut"] },
    { "before": ["<leader>", "d", "O"], "commands": ["workbench.action.debug.stepOver"] },
    { "before": ["<leader>", "d", "i"], "commands": ["workbench.action.debug.stepInto"] },
    { "before": ["<leader>", "d", "c"], "commands": ["workbench.action.debug.continue"] },
    { "before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "c", "r"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "c", "f"], "commands": ["editor.action.formatDocument"] },
    { "before": ["<leader>", "c", "o"], "commands": ["editor.action.organizeImports"] },
    { "before": ["<leader>", "c", "s"], "commands": ["workbench.action.gotoSymbol"] },
    { "before": ["<leader>", "c", "R"], "commands": ["editor.action.refactor"] },
    { "before": ["<leader>", "c", "d"], "commands": ["editor.action.showHover"] },
    { "before": ["<leader>", "c", "g"], "commands": ["editor.action.sourceAction"] },
    { "before": ["]", "d"], "commands": ["editor.action.marker.nextInFiles"] },
    { "before": ["[", "d"], "commands": ["editor.action.marker.prevInFiles"] },
    { "before": ["<C-w>", "d"], "commands": ["editor.action.showHover"] },
    { "before": ["<leader>", "x", "x"], "commands": ["workbench.actions.view.problems"] },
    { "before": ["<leader>", "x", "m"], "commands": ["workbench.actions.view.problems"] },
    { "before": ["<leader>", "g", "g"], "commands": ["workbench.view.scm"] },
    { "before": ["<leader>", "g", "b"], "commands": ["git.checkout"] },
    { "before": ["<leader>", "g", "B"], "commands": ["git.blame.toggleEditorDecoration"] },
    { "before": ["<leader>", "g", "h"], "commands": ["timeline.focus"] },
    { "before": ["<leader>", "g", "c"], "commands": ["git.commit"] },
    { "before": ["<leader>", "g", "n"], "commands": ["git.branch"] },
    { "before": ["<leader>", "g", "p"], "commands": ["git.push"] },
    { "before": ["<leader>", "g", "P"], "commands": ["git.pull"] },
    { "before": ["<leader>", "g", "m"], "commands": ["git.merge"] },
    { "before": ["]", "h"], "commands": ["workbench.action.editor.nextChange"] },
    { "before": ["[", "h"], "commands": ["workbench.action.editor.previousChange"] },
    { "before": ["]", "H"], "commands": ["workbench.action.compareEditor.nextChange"] },
    { "before": ["[", "H"], "commands": ["workbench.action.compareEditor.previousChange"] },
    { "before": ["<leader>", "f", "t"], "commands": ["workbench.action.terminal.toggleTerminal"] },
    { "before": ["<C-/>"], "commands": ["workbench.action.terminal.toggleTerminal"] },
    { "before": ["<leader>", "f", "p"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "f", "g"], "commands": ["workbench.view.scm"] },
    { "before": ["<leader>", "f", "n"], "commands": ["workbench.action.files.newUntitledFile"] },
    { "before": ["<C-o>"], "commands": ["workbench.action.navigateBack"] },
    { "before": ["<C-i>"], "commands": ["workbench.action.navigateForward"] },
    { "before": ["<leader>", "v", "r"], "commands": ["workbench.action.reloadWindow"] },
    { "before": ["<leader>", "h", "r", "r"], "commands": ["workbench.action.reloadWindow"] },
    { "before": ["<leader>", "u", "i", "t"], "commands": ["workbench.action.openGlobalKeybindings"] },
    { "before": ["<leader>", "r", "r"], "commands": ["workbench.action.debug.run"] },
    { "before": ["<leader>", "r", "m"], "commands": ["workbench.action.debug.selectandstart"] },
    { "before": ["]", "n"], "commands": ["editor.action.nextMatchFindAction"] },
    { "before": ["[", "n"], "commands": ["editor.action.previousMatchFindAction"] },
    { "before": ["<leader>", "a", "a"], "commands": ["workbench.action.chat.open"] }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["<"], "after": ["<", "g", "v"] },
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<leader>", "s", "w"], "commands": ["workbench.action.findInFiles"] }
  ]
}
